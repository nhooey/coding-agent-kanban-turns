// The defaults of the coding-agent-kanban-turns plugin: every setting it
// reads, with the value it uses when no file of yours sets it.
//
// The plugin reads this file from its own folder each session, and nothing
// else holds these values. To change a setting, write only that key in
// your own file, $XDG_CONFIG_HOME/coding-agent-kanban-turns/config.jsonc
// (~/.config/coding-agent-kanban-turns/config.jsonc when XDG_CONFIG_HOME
// is unset), such as
//
//   {"keys": {"dismiss": "x"}}
//
// Sections merge key by key, so every key you leave out comes from here
// and follows this file as it changes. A key that's no setting here, or a
// value of the wrong type, refuses your whole file: the plugin uses these
// defaults and says why in the pane and in /answers-config, which lists
// every setting in effect and the file it came from. An `outstanding`
// section, which the plugin no longer reads, is left out with a warning
// instead, and the rest of your file is used.
{
  // The count line above the prompt, such as `📌 Outstanding: 🚧 2 · 🧠 3`,
  // which the plugin works out from this session's transcript.
  "counts": {
    // How many of the latest turns it reads the open items from, as the
    // kanban skill's `outstanding.py render --counts` does; never further
    // back than the latest `reassess` turn, whose lists replace the rest.
    // 0 or less reads every turn since that `reassess` turn, or since the
    // session began when there is none.
    "turns": 20,
    // How long the one `gh api graphql` call that asks which of the Review
    // items' pull requests merged may take, in milliseconds. A `gh` that
    // takes longer, fails or is missing settles no Review item.
    "gh-timeout-ms": 20000
  },

  // The pane's hotkeys, pressed while the pane holds the keyboard (as it
  // opens from /answers or the line above the prompt, or after a click).
  "keys": {
    // ❌: close the pane.
    "dismiss": "q"
  },

  // The colours each part is drawn in, by the name of a colour in Claude
  // Code's theme, so each keeps its contrast in light and dark themes.
  "colors": {
    // The rounded border round an item.
    "border": "promptBorder",
    // The item's title line.
    "title": "claude",
    // Code spans in a summary, note or option.
    "code": "permission",
    // The background of the option the draft picks.
    "chosen": "diffAddedWord",
    // The bar in the column left of an option, lit down the option's
    // full height while the pointer is over any of its lines.
    "hover": "suggestion",
    // The ↗ arrow beside 🪟 after the count line above the prompt, the
    // button that opens the pane.
    "expand": "claude"
  }
}
