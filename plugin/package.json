{
  "name": "coding-agent-kanban-turns",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test 'test/unit/**/*.test.ts'",
    "typecheck": "tsc -p .",
    "typecheck:plugin": "test -f .claude-plugin/types/tsconfig.json || { echo 'no .claude-plugin/types/: load the plugin in Claude Code once (see README)' >&2; exit 1; }; tsc -p tsconfig.plugin.json",
    "test:plugin": "bash tools/plugin-test.sh",
    "spec:build": "node tools/spec/compile.ts",
    "spec:check": "node tools/spec/compile.ts --check"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "expect": "^30.5.2",
    "fast-check": "^4.10.3",
    "typescript": "^7.0.2"
  }
}
